ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# Google Cloud OAuth client: application type "Web application".
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# In production use your HTTPS origin and register its exact callback URI.
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v27.0
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Server-only .p8 key; escaped \n or real newlines accepted.
APPLE_PRIVATE_KEY=
# Optional, comma-separated verified Google emails permitted to administer posts.
# Google users are readers unless explicitly listed here.
ADMIN_GOOGLE_EMAILS=
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-7681125837419532
NEXT_PUBLIC_ADSENSE_SLOT=9654708635

# VPS/local only. Cloudflare uses DB (D1) and MEDIA (R2) bindings instead.
DATABASE_PATH=data/app.sqlite
UPLOAD_DIR=data/uploads
# Set true while exporting a consistent remote backup; then set false.
READ_ONLY=false

# Optional: read public production content directly during npm run dev.
# No local database or downloaded image copies in this mode.
CONTENT_API_URL=
