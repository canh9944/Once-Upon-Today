PORT=4000
HOST=127.0.0.1
APP_URL=http://localhost:3000
DATABASE_PATH=./data/app.sqlite
UPLOAD_DIR=./data/uploads
# backend/.env is loaded first; existing root .env.local is a fallback.
# Copy credentials from your configuration here only if deploying backend separately.
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_EMAILS=
# Optional source for the explicit, one-time JSON import command:
# LEGACY_STORE_PATH=../data/store.json
