{
  "name": "once-upon-today",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/runtime.mjs node_modules/next/dist/bin/next dev",
    "dev:frontend": "node scripts/runtime.mjs node_modules/next/dist/bin/next dev",
    "build": "node scripts/runtime.mjs node_modules/next/dist/bin/next build --webpack",
    "build:frontend": "node scripts/runtime.mjs node_modules/next/dist/bin/next build --webpack",
    "db:import": "node scripts/runtime.mjs --import tsx scripts/import-legacy.mts",
    "start": "node scripts/runtime.mjs node_modules/next/dist/bin/next start",
    "start:frontend": "node scripts/runtime.mjs node_modules/next/dist/bin/next start",
    "typecheck": "node scripts/runtime.mjs node_modules/typescript/bin/tsc --noEmit",
    "test:smoke": "node scripts/runtime.mjs scripts/smoke.mjs",
    "test:browser": "node scripts/runtime.mjs scripts/auth-browser.mjs",
    "build:cloudflare": "node scripts/runtime.mjs scripts/cloudflare.mjs build",
    "preview:cloudflare": "node scripts/runtime.mjs scripts/cloudflare.mjs preview",
    "deploy:cloudflare": "node scripts/runtime.mjs scripts/cloudflare.mjs deploy",
    "db:migrate:cloudflare": "node scripts/runtime.mjs node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --remote",
    "db:migrate:cloudflare:local": "node scripts/runtime.mjs node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --local",
    "cloudflare:login": "node scripts/runtime.mjs node_modules/wrangler/bin/wrangler.js login",
    "cloudflare:d1:create": "node scripts/runtime.mjs node_modules/wrangler/bin/wrangler.js d1 create once-upon-today",
    "cloudflare:r2:create": "node scripts/runtime.mjs node_modules/wrangler/bin/wrangler.js r2 bucket create once-upon-today-media",
    "backup": "node scripts/runtime.mjs scripts/transfer.mjs export",
    "restore": "node scripts/runtime.mjs scripts/transfer.mjs import",
    "test:cloudflare": "node scripts/runtime.mjs scripts/cloudflare-smoke.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "image-size": "^2.1.0",
    "jose": "^6.2.17",
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "wrangler": "^4.162.0",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "glob": "^14.0.2"
  }
}
